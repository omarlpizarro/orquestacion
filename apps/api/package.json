{
  "name": "@orq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./collaboration": {
      "source": "./src/modules/collaboration/collaboration.module.ts",
      "types": "./dist/src/modules/collaboration/collaboration.module.d.ts",
      "default": "./dist/src/modules/collaboration/collaboration.module.js"
    },
    "./notifications": {
      "source": "./src/modules/notifications/notifications.module.ts",
      "types": "./dist/src/modules/notifications/notifications.module.d.ts",
      "default": "./dist/src/modules/notifications/notifications.module.js"
    },
    "./projects": {
      "source": "./src/modules/projects/projects.module.ts",
      "types": "./dist/src/modules/projects/projects.module.d.ts",
      "default": "./dist/src/modules/projects/projects.module.js"
    },
    "./tenancy": {
      "source": "./src/modules/tenancy/tenancy.module.ts",
      "types": "./dist/src/modules/tenancy/tenancy.module.d.ts",
      "default": "./dist/src/modules/tenancy/tenancy.module.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:ensure-default-sites": "node dist/src/scripts/ensure-default-sites.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@orpc/nest": "1.15.2",
    "@orpc/server": "1.15.2",
    "@orq/config": "workspace:*",
    "@orq/contracts": "workspace:*",
    "@orq/db": "workspace:*",
    "better-auth": "1.7.5",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "auth": "1.7.5",
    "@nestjs/testing": "12.0.3",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
