# Copiá este archivo a infra/docker/.env en el server (está en .gitignore) y
# reemplazá TODOS los CHANGE_ME. `scripts/deploy.sh` se niega a correr si
# queda alguno.
#
# Generá cada secreto con:  openssl rand -hex 24
# Hex a propósito: el script de init de Postgres sustituye estos valores con
# `sed`, y un `/` o un `&` en el password lo rompería.

POSTGRES_IMAGE=postgres:17-alpine

POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
APP_OWNER_PASSWORD=CHANGE_ME
APP_LOGIN_PASSWORD=CHANGE_ME
APP_WORKER_PASSWORD=CHANGE_ME

# Firma cookies de sesión. Distinto del de cualquier otro ambiente.
BETTER_AUTH_SECRET=CHANGE_ME

# URL pública de la API, tal como la ve el navegador. El esquema decide si las
# cookies de sesión salen con `Secure` (ver README, "Cookies y TLS"):
#   http://...  -> cookies sin Secure, andan sin TLS (solo para esta prueba)
#   https://... -> cookies con Secure, exige TLS de punta a punta
BETTER_AUTH_URL=http://192.168.0.105:18020

# Puerto del host donde se publica la API. Verificado libre en el server el
# 2026-09-29 (ocupados: 22, 1433, 3000, 5432, 6333, 6334, 6379, 8000, 8080,
# 18000, 18010). `deploy.sh` vuelve a chequearlo antes de levantar.
API_HOST_PORT=18020
