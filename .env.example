# Copiá este archivo a .env y completá los valores para desarrollo local.
# Nunca commitees .env con passwords reales.

NODE_ENV=development
PORT=3000

# Imagen de Postgres. Única fuente de verdad: la usan tanto
# infra/docker/compose.dev.yml como el arnés de Testcontainers.
POSTGRES_IMAGE=postgres:17-alpine

# Passwords locales de desarrollo, inyectados en infra/docker/postgres/init/
# al crear los roles. No son secretos de producción.
APP_OWNER_PASSWORD=app_owner_dev_password
APP_LOGIN_PASSWORD=app_login_dev_password

# Conexión de la aplicación: rol app_login, nunca el dueño del esquema.
DATABASE_URL=postgres://app_login:app_login_dev_password@localhost:5432/orquestacion
DATABASE_APP_ROLE=app_login

# Conexión de las migraciones: rol app_owner. Nunca la usa la aplicación en runtime.
DATABASE_MIGRATION_URL=postgres://app_owner:app_owner_dev_password@localhost:5432/orquestacion

# apps/web: dónde encontrar la API en desarrollo.
API_URL=http://localhost:3000

# Better Auth: firma cookies de sesión y tokens. Generar uno propio en cada
# ambiente (por ejemplo `openssl rand -base64 32`), nunca reusar este valor.
BETTER_AUTH_SECRET=dev_secret_cambiar_en_cada_ambiente_1234567890
BETTER_AUTH_URL=http://localhost:3000

# Testcontainers en Windows: si corrés `pnpm test:integration` desde Git Bash
# en vez de PowerShell, puede hacer falta MSYS_NO_PATHCONV=1 porque MSYS
# traduce la ruta del socket de Docker que Testcontainers monta para Ryuk.
# MSYS_NO_PATHCONV=1
